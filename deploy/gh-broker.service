[Unit]
Description=CLDMV gh-broker — GitHub MCP credential-routing proxy
Documentation=https://github.com/CLDMV/gh-broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gh-broker
Group=gh-broker

# Secrets: the daemon resolves the config's cred: refs via the provider chosen at
# install — systemd-creds (a unit drop-in adds LoadCredentialEncrypted, delivering
# creds into $CREDENTIALS_DIRECTORY) or an agent-unreadable file (0640 root:gh-broker).
# See secrets.ts / docs/deploy-architecture.md.

# Socket dir /run/gh-broker (traversable), owned by the service user; the daemon
# creates one socket per agent under /run/gh-broker/agents, each 0660 with group
# gh-broker-agent-<user>, so only that agent can connect and the broker knows who
# is calling. The token stays server-side.
RuntimeDirectory=gh-broker
RuntimeDirectoryMode=0755

# Node comes from the maintained /usr/local/bin/node symlink (the installer points
# it at the chosen node and re-points it on a bump), so no node version is pinned
# here and there is no nvm resolution at start. The symlink is the single source of
# truth, so CLI node == service node by construction. See docs/deploy-architecture.md.
# The audit log (stdout) and `gh-broker otp unlock` both log as gh-broker: journalctl -t gh-broker
SyslogIdentifier=gh-broker
ExecStart=/usr/local/bin/node /opt/gh-broker/dist/index.mjs --config /etc/gh-broker/config.json
Restart=on-failure
RestartSec=2

# ---- hardening (least privilege for a credential holder) ----
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# NOTE: MemoryDenyWriteExecute is intentionally OMITTED — V8's JIT requires
# writable→executable memory, and enabling it crashes Node at startup with
# "Fatal OOM ... during deserialization".
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/gh-broker
# OTP gate state (lock counters, hard lock): /var/lib/gh-broker, created 0700 gh-broker:gh-broker.
# StateDirectory= makes it writable under ProtectSystem=strict; `sudo gh-broker otp unlock` edits it.
StateDirectory=gh-broker
StateDirectoryMode=0700
UMask=0077
# Optional egress lockdown once GitHub ranges are pinned:
# IPAddressDeny=any
# IPAddressAllow=<github api ranges>

[Install]
WantedBy=multi-user.target
