{
	"name": "@cldmv/gh-broker",
	"version": "0.5.1",
	"description": "Local credential-routing MCP proxy: holds per-org GitHub PATs out of the agent's reach, routes by repo owner, exposes a config-driven default-deny toolset in front of GitHub's hosted MCP.",
	"type": "module",
	"license": "Apache-2.0",
	"bin": {
		"gh-broker": "./dist/index.mjs"
	},
	"main": "./dist/index.mjs",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "npm run typecheck && rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --sourcemap",
		"start": "node dist/index.mjs",
		"dev": "node --experimental-strip-types --watch src/index.ts",
		"build:ci": "npm run build",
		"test:types": "npm run typecheck",
		"test": "node tests/run-vitest.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage",
		"fix:headers": "fix-headers --config .configs/fix-headers.json"
	},
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/gh-broker.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/gh-broker/issues"
	},
	"homepage": "https://github.com/CLDMV/gh-broker#readme",
	"devDependencies": {
		"@cldmv/configs": "^1.2.0",
		"@cldmv/fix-headers": "^2.1.1",
		"@cldmv/vitest-runner": "^1.5.1",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^5.0.2",
		"esbuild": "^0.28.2",
		"typescript": "^6.0.3",
		"vitest": "^5.0.1"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.31.0",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/core": "^7.0.8"
	},
	"publishConfig": {
		"access": "public"
	},
	"allowScripts": {
		"esbuild": true
	}
}
