{
	"name": "@cldmv/gh-broker",
	"version": "0.17.0",
	"description": "Local credential-routing MCP proxy: holds per-org GitHub PATs out of the agent's reach, routes by repo owner, exposes a config-driven default-deny toolset in front of GitHub's hosted MCP.",
	"type": "module",
	"license": "Apache-2.0",
	"bin": {
		"gh-broker": "bin/gh-broker.mjs"
	},
	"exports": {
		".": {
			"types": "./types/core/index.d.ts",
			"default": "./dist/core/index.mjs"
		},
		"./package.json": "./package.json",
		"./core": {
			"types": "./types/core/index.d.ts",
			"default": "./dist/core/index.mjs"
		}
	},
	"main": "./dist/core/index.mjs",
	"files": [
		"dist",
		"!dist/**/*.map",
		"types",
		"bin",
		"!bin/**/*.map",
		"deploy/gh-broker.service",
		"config.example.json",
		"config.sample.json"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.0",
			"onFail": "error"
		}
	},
	"scripts": {
		"types:check": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs --fix .",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"prebuild": "rm -rf dist types bin",
		"build": "npm run types:check && tsup && npm run test:dist",
		"start": "node dist/index.mjs",
		"dev": "node --experimental-strip-types --watch src/index.ts",
		"build:ci": "npm run lint && npm run format:check && npm run build",
		"test": "node tests/run-vitest.mjs",
		"test:dist": "node tests/dist-smoke.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage",
		"fix:headers": "fix-headers --config .configs/fix-headers.json",
		"prepack": "npm run build",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\""
	},
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/gh-broker.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/gh-broker/issues"
	},
	"homepage": "https://github.com/CLDMV/gh-broker#readme",
	"devDependencies": {
		"@cldmv/configs": "^1.3.0",
		"@cldmv/eslint-plugin-jsonv": "^1.1.2",
		"@cldmv/fix-headers": "^2.2.3",
		"@cldmv/jsonv": "^1.2.2",
		"@cldmv/prettier-plugin-jsonv": "^1.2.2",
		"@cldmv/vitest-runner": "^1.5.6",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^9.0.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.15.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@cldmv/lib-otp": "^0.2.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/core": "^7.0.8"
	},
	"publishConfig": {
		"access": "public"
	},
	"allowScripts": {
		"esbuild": true
	},
	"overrides": {
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	},
	"types": "./types/core/index.d.ts",
	"sideEffects": false
}
