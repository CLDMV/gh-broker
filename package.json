{
	"name": "@cldmv/gh-broker",
	"version": "0.1.0",
	"private": true,
	"description": "Local credential-routing MCP proxy: holds per-org GitHub PATs out of the agent's reach, routes by repo owner, exposes a config-driven default-deny toolset in front of GitHub's hosted MCP.",
	"type": "module",
	"license": "Apache-2.0",
	"bin": {
		"gh-broker": "./dist/index.mjs"
	},
	"main": "./dist/index.mjs",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "npm run typecheck && rm -rf dist && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.mjs --sourcemap",
		"start": "node dist/index.mjs",
		"dev": "node --experimental-strip-types --watch src/index.ts"
	},
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/gh-broker.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/gh-broker/issues"
	},
	"homepage": "https://github.com/CLDMV/gh-broker#readme",
	"devDependencies": {
		"@types/node": "^26.1.0",
		"esbuild": "^0.28.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0"
	}
}
